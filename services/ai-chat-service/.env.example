# CppAIService Environment Configuration Template
# Copy this file to .env and fill in your configuration
#
# IMPORTANT: In Docker Compose, use the MySQL service name as the hostname.

#===============================================================================
# Docker Services (DO NOT change these when using docker-compose)
#===============================================================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=chatuser
MYSQL_PASSWORD=replace_with_a_strong_password
MYSQL_DATABASE=chatserver
MYSQL_POOL_SIZE=5

#===============================================================================
# AI API Keys
#===============================================================================
# DeepSeek API Key (Required for chat features)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
AI_MODEL=deepseek-v4-flash
AI_API_URL=https://api.deepseek.com/chat/completions
AI_REQUEST_TIMEOUT_SECONDS=60
AI_CONNECT_TIMEOUT_SECONDS=10
AI_STREAM_IDLE_TIMEOUT_SECONDS=90
AI_WORKER_COUNT=4
AI_QUEUE_CAPACITY=32

# Alibaba Cloud Knowledge Base ID (Required for RAG features)
# KNOWLEDGE_BASE_ID=your_knowledge_base_id_here

# Doubao API Key (Optional, for Doubao AI features)
# DOUBAO_API_KEY=your_doubao_api_key_here

# Baidu Speech Synthesis Config (Optional)
# BAIDU_CLIENT_ID=your_baidu_client_id_here
# BAIDU_CLIENT_SECRET=your_baidu_client_secret_here

#===============================================================================
# Server Configuration
#===============================================================================
HTTP_PORT=80
HTTP_THREAD_COUNT=4
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=false
CHAT_CONTEXT_MESSAGES=40
CHAT_HISTORY_MESSAGES=200
CHAT_RETENTION_DAYS=90
IMAGE_RECOGNITION_ENABLED=true
IMAGE_MODEL_PATH=/root/models/mobilenetv2/mobilenetv2-7.onnx
IMAGE_LABEL_PATH=/root/imagenet_classes.txt
